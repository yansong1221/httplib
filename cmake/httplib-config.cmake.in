@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost REQUIRED COMPONENTS beast json)
find_dependency(spdlog REQUIRED)
find_dependency(fmt REQUIRED)

set(HTTPLIB_ENABLED_SSL @HTTPLIB_ENABLED_SSL@)
if(HTTPLIB_ENABLED_SSL)
    find_dependency(OpenSSL REQUIRED)
endif()

set(HTTPLIB_ENABLED_COMPRESS @HTTPLIB_ENABLED_COMPRESS@)
if(HTTPLIB_ENABLED_COMPRESS)
    find_dependency(Boost REQUIRED COMPONENTS iostreams)
    find_dependency(unofficial-brotli REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/httplib-targets.cmake")

check_required_components(httplib)
